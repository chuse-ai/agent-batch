{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "durable_objects": {
    "bindings": [{ "name": "HUB_CONNECTION", "class_name": "HubConnection" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HubConnection"] }],
  "services": [{ "binding": "HUB", "service": "hub" }],
  "vars": { "RUNNER_ID": "", "RUNNER_NAME": "" },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
}
