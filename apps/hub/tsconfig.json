{
  "compilerOptions": {
    "target": "esnext",
    // Only runtimes we choose run the hub, Node 26 and workerd (ADR 0024).
    "lib": ["esnext"],
    "module": "es2022",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "node"]
  }
}
