{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  // Better Auth uses Node's AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "RUNNER_CONNECTION", "class_name": "RunnerConnection" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerConnection"] }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // A placeholder: set the real Hyperdrive configuration ID before deploying. Locally, Wrangler
      // reads the connection string from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "00000000000000000000000000000000",
    },
  ],
  "vars": {
    // The request header carrying the client's IP address, for Better Auth's rate limits.
    "CLIENT_IP_HEADER": "cf-connecting-ip",
  },
  "secrets": {
    // `BETTER_AUTH_SECRET` signs sessions; generate one with `openssl rand -base64 32`.
    // `HUB_URL` is the hub's public URL: Better Auth's base URL, for its links, its trusted origin
    // and whether cookies are `Secure`, and the address anything else gives out. It is not secret,
    // but Wrangler declares required settings only here, and a default would silently give wrong
    // links and cookies. Locally, see `.dev.vars.example`.
    "required": ["BETTER_AUTH_SECRET", "HUB_URL"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
}
