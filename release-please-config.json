{
  "packages": {
    ".": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "json", "path": "apps/hub/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/runner/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/contract/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "compose.yaml" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
