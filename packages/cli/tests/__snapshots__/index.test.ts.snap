        {
          "arguments": [],
          "commands": [],
          "description": "Creates a Batch, without jobs, and answers with it: the \`agent\` every job added to it runs, set once, its labels and its failure breaker. Add its jobs with \`POST /batches/{id}/jobs\`. The hub checks the Result contract's schema, refusing one that is invalid, describes a list or refers outside itself. A \`customId\` makes the creation safe to retry: the same \`customId\` with the same \`agent\`, \`labels\` and \`breaker\` answers with the Batch already created, and with any of them different is refused.",
          "name": "create",
          "options": [
            {
              "attributeName": "customId",
              "description": "Your own ID for the Batch, unique in the Organization; none by default. Creating a Batch again with the same \`customId\` and the same \`agent\`, \`labels\` and \`breaker\` returns the Batch already created, so a creation can be retried safely; with any of them different it is refused. A new Batch needs a new ID.; Min length: 1; Max length: 255",
              "flags": "--custom-id [string]",
              "name": "custom-id",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
            },
            {
              "attributeName": "agent",
              "flags": "--agent <json>",
