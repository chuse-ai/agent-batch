{
  "name": "agent-batch",
  "version": "0.0.0",
  "description": "Run hundreds of one-off agent jobs unattended, each with a result contract. On your own machines first, spilling over to Cloudflare Workers.",
  "homepage": "https://github.com/chuse-ai/agent-batch#readme",
  "bugs": {
    "url": "https://github.com/chuse-ai/agent-batch/issues"
  },
  "license": "MIT",
  "author": "chuse <dev@chuse.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuse-ai/agent-batch.git",
    "directory": "packages/cli"
  },
  "bin": {
    "agent-batch": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "agent-batch": "./dist/bin.mjs"
    },
    "exports": {
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/platform-node-shared": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@standard-schema/utils": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "^12.3.0",
    "contract": "workspace:*",
    "effect": "catalog:",
    "ensure-error": "catalog:",
    "is-network-error": "catalog:",
    "rollup-plugin-license": "catalog:",
    "trpc-cli": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "inlinedDependencies": {
    "@orpc/client": "2.0.0-beta.44",
    "@orpc/contract": "2.0.0-beta.44",
    "@orpc/json-schema": "2.0.0-beta.44",
