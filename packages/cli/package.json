    "@orpc/zod": "2.0.0-beta.44",
    "@standard-schema/utils": "0.3.0",
    "@standard-server/core": "0.10.3",
    "@standard-server/fetch": "0.10.3",
    "@standard-server/shared": "0.10.3",
    "commander": "14.0.3",
    "content-type": "3.1.1",
    "effect": "4.0.5",
    "ensure-error": "5.0.0",
    "filename-reserved-regex": "4.1.0",
    "is-network-error": "1.3.2",
    "json-rpc-2.0": "1.8.1",
